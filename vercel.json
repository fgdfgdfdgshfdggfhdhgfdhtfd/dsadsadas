{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/manifest.json", "destination": "/site.webmanifest.json" }
  ],
  "headers": [
    { "source": "/icon-v2.png",   "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/icon-(.*)",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/og-image-v2.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/output.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/header-auth.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js",      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/",           "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/site.webmanifest.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/browserconfig.xml",     "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/sitemap.xml",           "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/api/(.*)",   "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
